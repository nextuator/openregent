ase: 17px;\n--text-lg: 21px;\n--text-xl: 27px;\n--text-2xl: 33px;\n--text-3xl: 42px;\n--radius-control: 6px;\n--radius-card: 12px;\n--space-section: 130px;\n--shadow-card: 0 1px 2px color-mix(in oklab, var(--color-text) 8%, transparent), 0 10px 30px color-mix(in oklab, var(--color-text) 12%, transparent);\n}\n*,*::before,*::after{box-sizing:border-box}\nhtml{-webkit-text-size-adjust:100%}\nbody{margin:0;background:var(--color-bg);color:var(--color-text);font-family:var(--font-body);font-size:var(--text-base);line-height:1.55;padding-top:36px}\nimg{max-width:100%;height:auto;display:block}\na{color:inherit}\nh1,h2,h3,h4{font-family:var(--font-display);line-height:1.1;margin:0 0 .5em}\np{margin:0 0 1em;max-width:70ch}\n.glowup-concept-banner{position:fixed;top:0;left:0;right:0;z-index:2147483647;height:36px;display:flex;align-items:center;justify-content:center;padding:0 12px;background:var(--color-text);color:var(--color-bg);font:600 13px/1.2 var(--font-body);text-align:center}\n</style>\n<style>\n\n*,\n*::before,\n*::after { box-sizing: border-box; }\n\nbody {\n  margin: 0;\n  background: var(--color-bg);\n  color: var(--color-text);\n  font-family: var(--font-body);\n  font-size: var(--text-base);\n  line-height: 1.7;\n}\n\nimg { display: block; max-width: 100%; height: auto; }\n\na { color: inherit; }\n\n.wrap {\n  width: 100%;\n  max-width: 72rem;\n  margin: 0 auto;\n  padding: 0 1.5rem;\n}\n\n/* Header */\n.site-header {\n  border-bottom: 1px solid var(--color-border);\n  background: var(--color-bg);\n}\n.site-header .wrap {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  justify-content: space-between;\n  gap: 1rem 2rem;\n  padding-top: 1.25rem;\n  padding-bottom: 1.25rem;\n}\n.brand { display: inline-flex; align-items: center; text-decoration: none; }\n.brand img { height: 3rem; width: auto; }\n.nav ul {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.5rem 1.5rem;\n}\n.nav a {\n  font-size: var(--text-sm);\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  text-decoration: none;\n  color: var(--color-text-muted);\n  padding-bottom: 0.2rem;\n  border-bottom: 1px solid transparent;\n}\n.nav a:hover,\n.nav a:focus-visible { color: var(--color-text); border-bottom-color: var(--color-accent); }\n.nav .nav-cta { color: var(--color-primary); font-weight: 600; }\n\n/* Hero */\n.hero { padding: 3rem 0 var(--space-section); }\n.hero-grid { display: grid; gap: 2.5rem; }\n.eyebrow {\n  margin: 0 0 1rem;\n  font-size: var(--text-sm);\n  letter-spacing: 0.18em;\n  text-transform: uppercase;\n  color: var(--color-text-muted);\n}\n.eyebrow strong { color: var(--color-primary); letter-spacing: 0.12em; }\n.hero h1 {\n  margin: 0;\n  font-family: var(--font-display);\n  font-size: var(--text-3xl);\n  line-height: 0.98;\n  letter-spacing: -0.02em;\n  font-weight: 700;\n}\n.hero h1 em {\n  font-style: italic;\n  font-weight: 400;\n  display: block;\n}\n.rule {\n  display: flex;\n  align-items: center;\n  gap: 0.75rem;\n  margin: 1.75rem 0;\n  max-width: 16rem;\n}\n.rule::before,\n.rule::after {\n  content: \"\";\n  flex: 1;\n  border-top: 1px solid var(--color-text);\n}\n.rule span {\n  width: 0.5rem;\n  height: 0.5rem;\n  background: var(--color-accent);\n  transform: rotate(45deg);\n}\n.hero-sub {\n  margin: 0 0 1rem;\n  max-width: 44ch;\n  font-size: var(--text-lg);\n  line-height: 1.6;\n}\n.hero-aside {\n  margin: 0 0 2rem;\n  max-width: 44ch;\n  color: var(--color-text-muted);\n  font-style: italic;\n}\n.btn {\n  display: inline-block;\n  padding: 0.95rem 1.6rem;\n  background: var(--color-primary);\n  color: var(--color-on-primary);\n  border-radius: var(--radius-control);\n  text-decoration: none;\n  font-weight: 600;\n  letter-spacing: 0.03em;\n}\n.btn:hover,\n.btn:focus-visible { background: var(--color-text); color: var(--color-bg); }\n\n.hero-photo { position: relative; margin: 0; }\n.hero-photo .frame {\n  border: 10px solid var(--color-primary);\n  border-radius: var(--radius-card);\n  overflow: hidden;\n  box-shadow: var(--shadow-card);\n  background: var(--color-primary);\n}\n.hero-photo img {\n  width: 100%;\n  aspect-ratio: 4 / 3;\n  object-fit: cover;\n}\n.hero-photo figcaption {\n  margin-top: 0.75rem;\n  font-size: var(--text-sm);\n  color: var(--color-text-muted);\n}\n.stamp {\n  position: absolute;\n  top: -1.25rem;\n  right: -0.5rem;\n  width: 7.5rem;\n  height: 7.5rem;\n  border-radius: 50%;\n  background: var(--color-accent);\n  color: var(--color-on-accent);\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  text-align: center;\n  transform: rotate(-12deg);\n  outline: 2px dashed var(--color-on-accent);\n  outline-offset: -8px;\n  line-height: 1.1;\n}\n.stamp b {\n  font-family: var(--font-display);\n  font-size: var(--text-lg);\n  text-transform: uppercase;\n  letter-spacing: 0.04em;\n}\n.stamp small { font-size: var(--text-sm); }\n\n/* Section heads */\n.section { padding: var(--space-section) 0; border-top: 1px solid var(--color-border); }\n.section-label {\n  margin: 0 0 0.5rem;\n  font-size: var(--text-sm);\n  letter-spacing: 0.18em;\n  text-transform: uppercase;\n  color: var(--color-text-muted);\n}\n.section h2 {\n  margin: 0 0 2rem;\n  font-family: var(--font-display);\n  font-size: var(--text-2xl);\n  line-height: 1.1;\n  font-weight: 700;\n}\n\n/* Offer – menu board */\n.offer { background: var(--color-surface); }\n.board { display: grid; gap: 2.5rem; }\n.menu {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n}\n.menu li {\n  display: flex;\n  align-items: baseline;\n  gap: 0.75rem;\n  padding: 1.25rem 0;\n  border-bottom: 1px solid var(--color-border);\n}\n.menu .item {\n  font-family: var(--font-display);\n  font-size: var(--text-xl);\n}\n.menu .dots {\n  flex: 1;\n  border-bottom: 2px dotted var(--color-text-muted);\n  transform: translateY(-0.3rem);\n  min-width: 1.5rem;\n}\n.menu .detail {\n  font-size: var(--text-sm);\n  letter-spacing