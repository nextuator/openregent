# Required: Gaffa browser API
GAFFA_API_KEY=
# Optional: Anthropic API. Without it, local dev falls back to `claude -p`; on Vercel live runs are off.
ANTHROPIC_API_KEY=
# Optional model overrides
LLM_MODEL_FAST=
LLM_MODEL_SMART=
# Optional: if set, API routes require the header x-demo-key
DEMO_KEY=
# Optional: alerts (ntfy.sh topic URL, Discord or Slack webhook) for billing, quota and server errors
NOTIFY_URL=
# Optional: live glow-ups per IP per 24 h (default 3)
RUNS_PER_IP_PER_DAY=
